# ══════════════════════════════════════════
#  AI Study Copilot — Environment Variables
#  Copy this file to .env and fill in values
# ══════════════════════════════════════════

# PRIMARY LLM — Groq (free tier, fast)
# Sign up at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# FALLBACK LLM — OpenRouter (free models)
# Sign up at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Flask security key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_secret

# App config (optional overrides)
# APP_TITLE=AI Study Copilot
# PORT=5000
# DEBUG=false
